{
  "name": "tier-matrix",
  "version": "0.1.0",
  "description": "Test every capability-tier degradation path your on-device AI app can take (WebGPU, WASM, cloud fallback) — not just the one you happen to be developing on.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/NagaYu/tier-matrix#readme",
  "bugs": {
    "url": "https://github.com/NagaYu/tier-matrix/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NagaYu/tier-matrix.git"
  },
  "keywords": [
    "testing",
    "webgpu",
    "graceful-degradation",
    "vitest",
    "playwright",
    "on-device-ai",
    "capability-detection"
  ],
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=18.18.0"
  },
  "files": ["dist"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./playwright": {
      "types": "./dist/playwright.d.ts",
      "import": "./dist/playwright.js",
      "require": "./dist/playwright.cjs"
    },
    "./presets/webgpu-radar": {
      "types": "./dist/presets/webgpu-radar.d.ts",
      "import": "./dist/presets/webgpu-radar.js",
      "require": "./dist/presets/webgpu-radar.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:example": "pnpm --filter smart-search-app-example test",
    "typecheck:example": "pnpm --filter smart-search-app-example typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0",
    "webgpu-radar": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "webgpu-radar": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.9.0",
    "playwright": "^1.48.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "esbuild"]
  }
}
